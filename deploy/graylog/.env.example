# Graylog version.
GRAYLOG_VERSION=7.1.9

# This deployment does NOT run Graylog's own Data Node. Graylog is configured
# as "self-managed OpenSearch" and points directly at the same OpenSearch
# cluster as the Wazuh Indexer, so its gl-events* indices land where CoPilot's
# Wazuh-Indexer connector already queries them (see README "Add optional
# services > Graylog" for why this matters). Format: scheme://user:pass@host:port,
# using the SAME host/port as WAZUH_INDEXER_URL in the main .env.
#
# CAVEAT: the exact minimal OpenSearch Security role/privileges a Graylog user
# needs on a security-enabled cluster are not documented anywhere (checked
# both Graylog's and SOCFortress's docs). Start by reusing the Wazuh Indexer
# admin credentials to prove the connection works, then narrow the privileges
# once Graylog is confirmed working -- do not assume a low-privilege role will
# work on the first try.
GRAYLOG_ELASTICSEARCH_HOSTS=https://admin:REPLACE_WITH_WAZUH_INDEXER_PASSWORD@wazuh-server:9200

# Generate with: openssl rand -hex 48
GRAYLOG_PASSWORD_SECRET=REPLACE_WITH_RANDOM_SECRET

# SHA-256 hash of the Graylog admin password.
# Generate with: printf '%s' 'CHANGE_ME' | sha256sum
GRAYLOG_ROOT_PASSWORD_SHA2=REPLACE_WITH_SHA256_PASSWORD_HASH

# Use the server's private hostname or IP and keep the trailing slash.
GRAYLOG_HTTP_EXTERNAL_URI=http://graylog.home.lan:9000/
GRAYLOG_HTTP_PORT=9000

# Wazuh commonly uses host ports 1514-1516. Graylog listens internally on
# 1514, but uses dedicated high host ports for UDM and other devices.
GRAYLOG_SYSLOG_UDP_PORT=2514
GRAYLOG_SYSLOG_TCP_PORT=2515
