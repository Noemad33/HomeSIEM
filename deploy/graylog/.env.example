# Keep Graylog and Graylog Data Node on the same release.
GRAYLOG_VERSION=7.1.9

# OpenSearch heap for Graylog Data Node. 8g is a conservative home-lab default.
# Consider 16g for sustained higher ingest; do not blindly use 50% of host RAM.
GRAYLOG_DATANODE_OPENSEARCH_HEAP=8g

# Generate with: openssl rand -hex 48
GRAYLOG_PASSWORD_SECRET=REPLACE_WITH_RANDOM_SECRET

# SHA-256 hash of the Graylog admin password.
# Generate with: printf '%s' 'CHANGE_ME' | sha256sum
GRAYLOG_ROOT_PASSWORD_SHA2=REPLACE_WITH_SHA256_PASSWORD_HASH

# Use the server's private hostname or IP and keep the trailing slash.
GRAYLOG_HTTP_EXTERNAL_URI=http://graylog.home.lan:9000/
GRAYLOG_HTTP_PORT=9000

# Wazuh commonly uses host ports 1514-1516. Graylog listens internally on
# 1514, but uses dedicated high host ports for UDM and other devices.
GRAYLOG_SYSLOG_UDP_PORT=2514
GRAYLOG_SYSLOG_TCP_PORT=2515
