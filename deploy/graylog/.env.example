# Graylog version.
GRAYLOG_VERSION=7.1.9

# This deployment does NOT run Graylog's own Data Node. Graylog is configured
# as "self-managed OpenSearch" and points directly at the same OpenSearch
# cluster as the Wazuh Indexer, so its gl-events* indices land where CoPilot's
# Wazuh-Indexer connector already queries them (see README "Add optional
# services > Graylog" for why this matters). Format: scheme://user:pass@host:port,
# using the SAME host/port as WAZUH_INDEXER_URL in the main .env.
#
# CAVEAT: the exact minimal OpenSearch Security role/privileges a Graylog user
# needs on a security-enabled cluster are not documented anywhere (checked
# both Graylog's and SOCFortress's docs). Start by reusing the Wazuh Indexer
# admin credentials to prove the connection works, then narrow the privileges
# once Graylog is confirmed working -- do not assume a low-privilege role will
# work on the first try.
GRAYLOG_ELASTICSEARCH_HOSTS=https://admin:REPLACE_WITH_WAZUH_INDEXER_PASSWORD@wazuh-server:9200

# Wazuh's own opensearch.yml ships with `compatibility.override_main_response_
# version: true` by default (see wazuh/wazuh-packages,
# stack/indexer/base/files/etc/wazuh-indexer/opensearch.yml -- it's there so
# Filebeat-oss 7.10.2 keeps working, nothing to do with Graylog). That makes
# the indexer's root endpoint report itself as Elasticsearch 7.10.2 even
# though it's real OpenSearch 2.x, which fools Graylog's automatic version
# probe into using the wrong query dialect -- symptom: "Elasticsearch
# exception ... key [types] is not supported in the metadata section" on
# Input Diagnostics, Search, and other pages once Graylog is otherwise
# running fine. This is a permanent, universal Wazuh default, not something
# to fix on the Wazuh side (and this stack leaves Wazuh's own config alone).
# Explicitly telling Graylog the real distribution/major version disables
# its version probe entirely, so the faked response is never consulted. The
# exact patch number doesn't matter -- Graylog only validates the major
# version (any 2.x.x satisfies it), it does not need to match the Wazuh
# Indexer's actual OpenSearch patch version.
GRAYLOG_ELASTICSEARCH_VERSION=opensearch:2.0.0

# Managed automatically by deploy/graylog/start.sh/.ps1 -- do not set these by
# hand. Wazuh's certificate is issued to a role name (e.g. "wazuh.indexer"),
# not an IP, so Java's TLS hostname verification rejects a connection made by
# IP even once the certificate itself is trusted. start.sh reads the name out
# of the fetched certificate, points GRAYLOG_ELASTICSEARCH_HOSTS above at it
# instead of the original host, and records that original host/IP here so
# Docker's extra_hosts (see docker-compose.yml) can still resolve it.
GRAYLOG_WAZUH_INDEXER_HOSTNAME=
GRAYLOG_WAZUH_INDEXER_IP=

# Generate with: openssl rand -hex 48
GRAYLOG_PASSWORD_SECRET=REPLACE_WITH_RANDOM_SECRET

# SHA-256 hash of the Graylog admin password.
# Generate with: printf '%s' 'CHANGE_ME' | sha256sum
GRAYLOG_ROOT_PASSWORD_SHA2=REPLACE_WITH_SHA256_PASSWORD_HASH

# Use the server's private hostname or IP and keep the trailing slash.
GRAYLOG_HTTP_EXTERNAL_URI=http://graylog.home.lan:9000/
GRAYLOG_HTTP_PORT=9000

# Wazuh commonly uses host ports 1514-1516. Graylog listens internally on
# 1514, but uses dedicated high host ports for UDM and other devices.
GRAYLOG_SYSLOG_UDP_PORT=2514
GRAYLOG_SYSLOG_TCP_PORT=2515
